<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="file"
        path="./updates" />
    <!-- DataStore holds the optional YouTube account cookie/session and other
         preferences. Credentials must not be copied to cloud backups. -->
    <exclude
        domain="file"
        path="./datastore/settings.preferences_pb" />
    <!-- WebView keeps its own cookie jar/storage outside DataStore. -->
    <exclude
        domain="root"
        path="./app_webview" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
</full-backup-content>
